# Postgres local (container db)
POSTGRES_PASSWORD=troque-esta-senha-forte

# API → banco local (não use Supabase após o restore)
# SEMEAR_DB_URL, SEMEAR_DB_USER e SEMEAR_DB_PASSWORD são definidos no docker-compose.yml

# URLs públicas (DuckDNS hoje; troque ao comprar domínio)
SEMEAR_CORS_ORIGINS=https://minha-igreja-digital-app.vercel.app
SEMEAR_MAIL_BASE_URL=https://minha-igreja-digital-app.vercel.app
SEMEAR_PUBLIC_API_URL=https://minha-igreja-digital.duckdns.org

# E-mail (Brevo) — copie do Render
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SEMEAR_MAIL_FROM=willtechsolutionsdev@gmail.com
SEMEAR_BREVO_API_KEY=

# SMS
SEMEAR_SMS_ENABLED=false
SEMEAR_SMS_SENDER=MinhaIgreja

# Push (Firebase) — copie do Render
SEMEAR_PUSH_ENABLED=true
SEMEAR_PUSH_TESTE_ENABLED=false
SEMEAR_FIREBASE_PROJECT_ID=semear-push
SEMEAR_FIREBASE_VAPID_PUBLIC_KEY=
SEMEAR_FIREBASE_SERVICE_ACCOUNT=

# Uploads persistentes na VPS (recomendado)
SEMEAR_UPLOAD_DIR=/var/lib/semear/uploads
